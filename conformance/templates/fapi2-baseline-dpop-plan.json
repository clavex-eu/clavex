{
  "description": "clavex \u2014 FAPI 2.0 Security Profile Baseline (DPoP) certification test plan",
  "alias": "clavex-fapi",
  "variant": {
    "openid": "openid_connect",
    "fapi_profile": "plain_fapi",
    "sender_constrain": "dpop",
    "client_auth_type": "private_key_jwt"
  },
  "server": {
    "discoveryUrl": "${BACKEND_ORIGIN}/conformance/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "conformance-client-fapi-dpop",
    "scope": "openid profile email"
  },
  "client2": {
    "client_id": "conformance-client-fapi-dpop-2",
    "scope": "openid profile email"
  },
  "resource": {
    "resourceUrl": "${BACKEND_ORIGIN}/conformance/userinfo"
  },
  "waitTimeoutSeconds": 60
}
